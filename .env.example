# Docker Compose settings for the local stack. Copy this file to .env in the repository root:
#
#     cp .env.example .env
#
# Compose reads it when it starts the stack. Nothing here is passed to the backend container;
# the application's own settings (Mailjet, admin panel, rate limits) live in backend/.env,
# see backend/.env.example. .env is ignored by Git, so real credentials belong there and
# never in this file, which holds demo values only.
#
# MySQL stores these credentials in its data directory when the volume is first created.
# Changing them afterwards has no effect until the volume is recreated:
#
#     docker compose down -v && docker compose up --build     # deletes all stored submissions
#
# compose.yaml holds no credentials of its own, so this copy is required: without .env the
# stack refuses to start and says so.

# Used by the mysql image's own bootstrap and nothing else: the backend and the migrations
# connect as MYSQL_USER. Setting it explicitly is what keeps the image from generating a root
# password and printing it into `docker compose logs mysql`.
MYSQL_ROOT_PASSWORD=local_root_password

# The database and the application account created on first start. Keep MYSQL_USER,
# MYSQL_PASSWORD and MYSQL_DATABASE in step with DATABASE_URL in backend/.env, which is what
# the local uv workflow connects with (under Docker, Compose builds that URL from these).
MYSQL_DATABASE=email_confirmation
MYSQL_USER=email_app
# Compose substitutes this into DATABASE_URL, so keep it URL-safe: no @ : / ? # % or spaces,
# which would be read as the end of the password and point the backend at another host.
MYSQL_PASSWORD=email_app_password

# Optional. The published ports, if 4200 or 3306 are already taken on your machine.
# FRONTEND_PORT=4200
# MYSQL_PORT=3306
