# Production settings for docker-compose.prod.yml. On the server, copy this file and fill it in:
#
#     cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod is ignored by Git and read only by `docker compose --env-file .env.prod`; no image
# contains it. This file holds placeholders only. Generate each secret, for example with
# `openssl rand -hex 32`: hex is URL-safe, which MYSQL_PASSWORD requires, and has no `$`, which
# Compose would treat as a variable reference in any value.
# Guide: docs/deployment-vps.md.

# Public host name; its DNS A record must point at the server.
DOMAIN=email.zsz13.com
# Contact address certbot registers the Let's Encrypt account with.
LETSENCRYPT_EMAIL=change-me@example.com

# MySQL stores these when its volume is first created; changing them later has no effect on
# an existing volume. The backend and the migrations connect as MYSQL_USER, never as root.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=email_confirmation
MYSQL_USER=email_app
# Substituted into the database URL, so keep it URL-safe: no @ : / ? # % or spaces.
MYSQL_PASSWORD=change-me

# Mailjet Send API credentials (https://app.mailjet.com/account/apikeys) and a sender address
# verified in that Mailjet account.
MAILJET_API_KEY=change-me
MAILJET_SECRET_KEY=change-me
MAILJET_SENDER_EMAIL=change-me@example.com
MAILJET_SENDER_NAME=Email Confirmation System

# Read-only admin panel login, at the admin path from the README. The backend refuses the
# committed demo values in production.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me

# HTTP Basic Auth in front of the whole site. Startup refuses empty values and change-me.
BASIC_AUTH_USERNAME=change-me
BASIC_AUTH_PASSWORD=change-me
