# Backend settings. Copy this file to backend/.env and replace the placeholder values.
# The production stack does not read this file: docker-compose.prod.yml passes the backend an
# explicit list of settings from .env.prod, so a new required setting belongs there too.
# backend/.env is ignored by Git and excluded from the Docker build context; never commit
# real credentials. The MySQL container's own credentials live in the repository-root .env
# (see .env.example there); this file only needs the URL the application connects with.

# Async SQLAlchemy URL for the local uv workflow (MySQL published on 127.0.0.1 by compose.yaml).
# Under `docker compose up` this value is overridden to reach the mysql service by name.
DATABASE_URL=mysql+asyncmy://email_app:email_app_password@127.0.0.1:3306/email_confirmation

# Mailjet Send API v3.1 credentials (https://app.mailjet.com/account/apikeys).
MAILJET_API_KEY=replace_me
MAILJET_SECRET_KEY=replace_me
# Must be a sender address verified in your Mailjet account.
MAILJET_SENDER_EMAIL=verified-sender@example.com
MAILJET_SENDER_NAME=Email Confirmation System

# Comma-separated list of browser origins allowed to call the API directly (local development).
CORS_ORIGINS=http://localhost:4200

# Optional. Python logging level for the backend (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Optional. How often, in seconds (at least 1), the backend asks Mailjet about confirmation
# emails that are still accepted, queued or retrying, until each reaches a final state. The
# default matches the page's 3-second status polling, which only reads what this stores; the
# page's interval is set separately in the frontend.
# DELIVERY_RECONCILE_INTERVAL_SECONDS=3

# Optional. Rate limits for POST /api/v1/submissions, on by default; the defaults are shown:
# 3 requests per 60 seconds per client IP, 3 per 600 seconds per destination mailbox.
# RATE_LIMIT_IP_MAX_REQUESTS=3
# RATE_LIMIT_IP_WINDOW_SECONDS=60
# RATE_LIMIT_EMAIL_MAX_REQUESTS=3
# RATE_LIMIT_EMAIL_WINDOW_SECONDS=600

# Optional. Per-IP rate limit for GET /api/v1/submissions/{tracking_id}/status, which the
# frontend polls every 3 seconds; the defaults are shown.
# RATE_LIMIT_STATUS_IP_MAX_REQUESTS=60
# RATE_LIMIT_STATUS_IP_WINDOW_SECONDS=60

# Optional. Read-only admin panel (SQLAdmin). The defaults below are the committed DEMO values
# for running this take-home locally; they are public and must be overridden, together with
# ADMIN_COOKIE_SECURE=true behind HTTPS, before any deployment reachable over a network.
# Changing ADMIN_PATH also requires updating the matching location in
# frontend/nginx-backend-locations.conf.
# ADMIN_PATH=/q7Vf2mZ9Kx4Tn8Rb3Lp6Hs1Yw5Dc0Gj4Ua9Pe2Nr7Bk6Xv3Qm8Sf1Zh5Wt0Cy4Ld9Jp2En7
# ADMIN_USERNAME=demo-admin
# ADMIN_PASSWORD=demo-admin-2026
# ADMIN_SESSION_SECRET=demo-only-session-secret-replace-in-production
# ADMIN_SESSION_MAX_AGE_SECONDS=28800
# Setting this to true (an HTTPS deployment) is refused while ADMIN_PASSWORD or
# ADMIN_SESSION_SECRET still hold the demo values above.
# ADMIN_COOKIE_SECURE=false
